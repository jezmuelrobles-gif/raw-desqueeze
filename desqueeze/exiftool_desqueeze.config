#------------------------------------------------------------------------------
# ExifTool config defining a custom XMP-Desqueeze namespace so this tool can
# record that a horizontal anamorphic desqueeze was applied, and at what
# factor, without clobbering any standard tag.
#
# Used automatically by `desqueeze` (see desqueeze/metadata.py); no manual
# setup needed unless you want to inspect/write these tags yourself with a
# bare `exiftool -config exiftool_desqueeze.config ...` invocation.
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        Desqueeze => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::Desqueeze',
            },
        },
    },
);

%Image::ExifTool::UserDefined::Desqueeze = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-Desqueeze', 2 => 'Image' },
    NAMESPACE => { 'Desqueeze' => 'https://github.com/desqueeze/ns/1.0/' },
    WRITABLE => 'string',
    Applied => { Writable => 'boolean' },
    SqueezeFactor => { Writable => 'rational64u' },
    OriginalRawFile => { Writable => 'string' },
    ColorSpace => { Writable => 'string' },
);

1; #end
